# Copiá este archivo a .env y completá lo que necesites. Nunca subas el .env al repo.

# --- Base de datos (Railway: referencia a ${{Postgres.DATABASE_URL}}) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cergo
DATABASE_POOL_MAX=10

# --- Panel y sesión ---
APP_URL=http://localhost:3000
# Mínimo 32 caracteres en producción. Cifra los secretos de 2FA.
AUTH_SECRET=
# true en producción (por defecto): el equipo CERGO entra sí o sí con 2FA.
REQUIRE_STAFF_MFA=
COOKIE_SECURE=false

# --- API ---
PORT=8080
# all (por defecto) | panel | voice  -> separar el tráfico de voz del panel si hace falta escalar.
API_ROLE=all
# Solo el panel web la usa: URL privada de la API (Railway: http://api.railway.internal:8080).
API_INTERNAL_URL=http://localhost:8080

# --- ElevenLabs (agente de voz) ---
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
COST_PER_MINUTE_USD=0.12

# --- Avisos ---
RESEND_API_KEY=
MAIL_FROM=CERGO <avisos@holacergo.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Grabaciones (S3 compatible: Railway Buckets, R2, S3). Sin esto se guardan en disco local. ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# --- Worker ---
WORKER_CONCURRENCY=8
WORKER_POLL_MS=2000
# Vacío = todas. Para separar colas en otro servicio: webhook.process,call.fetch_audio,notify.handoff,notify.booking,agent.publish,stats.recompute,maintenance.daily
WORKER_QUEUES=
MAINTENANCE_HOUR=4

# --- Datos de demo (pnpm db:seed) ---
SEED_PASSWORD=
SEED_OWNER_EMAIL=duena@casadellago.example
SEED_RECEPTION_EMAIL=recepcion@casadellago.example
SEED_STAFF_EMAIL=equipo@cergo.example
SEED_ELEVENLABS_AGENT_ID=

LOG_LEVEL=info
