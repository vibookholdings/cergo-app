{
  "name": "cergo-app",
  "private": true,
  "description": "Panel de CERGO para hoteles: llamadas, pendientes de recepción, reservas y configuración del agente de voz.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @cergo/web test:e2e",
    "db:generate": "pnpm --filter @cergo/db generate",
    "db:migrate": "pnpm --filter @cergo/db migrate",
    "db:seed": "pnpm --filter @cergo/db seed"
  },
  "devDependencies": {
    "@cergo/contracts": "workspace:*",
    "@cergo/core": "workspace:*",
    "@cergo/db": "workspace:*",
    "@cergo/integrations": "workspace:*",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.7",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
